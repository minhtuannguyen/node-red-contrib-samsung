{
  "name": "node-red-contrib-samsung",
  "version": "1.0.0",
  "description": "Node-RED nodes for controlling Samsung Tizen TVs over local network via WebSocket. Treats TV as off when unreachable.",
  "keywords": [
    "node-red",
    "samsung",
    "tizen",
    "tv",
    "smart-tv",
    "homeautomation"
  ],
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "node build.js",
    "prepublishOnly": "npm run build"
  },
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "samsung-tv-config": "dist/nodes/samsung-tv-config.js",
      "samsung-tv-command": "dist/nodes/samsung-tv-command.js",
      "samsung-tv-power": "dist/nodes/samsung-tv-power.js"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.25.0",
    "wol": "^1.0.3",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}

